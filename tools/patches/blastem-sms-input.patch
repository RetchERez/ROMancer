-static void advance_paste_buffer(sms_context *sms, const char *paste)
-{
-	if (!*paste) {
-		free(sms->header.paste_buffer);
-		sms->header.paste_buffer = NULL;
-	} else {
-		sms->header.paste_cur_char = paste - sms->header.paste_buffer;
-	}
-}
