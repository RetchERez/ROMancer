-		sms->bank_regs[bank] = value;
-		value &= 0x7F;
-		z80->mem_pointers[bank] = sms->rom + (value << 14 & (sms->rom_size-1));
-		z80_invalidate_code_range(z80, bank * 0x4000, bank * 0x4000 + 0x4000);
-	}
-	return z80;
