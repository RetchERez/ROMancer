+	[0x21] = 0x2008,//C
+	[0x23] = 0x2004,//D
+	[0x24] = 0x2002,//E
+	[0x2B] = 0x3004,//F
+	[0x34] = 0x4004,//G
+	[0x33] = 0x5004,//H
