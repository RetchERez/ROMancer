+static uint8_t hv_read(uint32_t location, void *vcontext)
+{
+	z80_context *z80 = vcontext;
+	sms_context *sms = z80->system;
+	vdp_run_context(sms->vdp, z80->Z80_CYCLE);
+	uint16_t hv = vdp_hv_counter_read(sms->vdp);
+	if (location & 1) {
+		return hv;
+	} else {
+		return hv >> 8;
+	}
+}
