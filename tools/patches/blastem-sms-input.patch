+uint8_t z80_size(z80inst * inst)
+{
+	uint8_t reg = (inst->reg & 0x1F);
+	if (reg != Z80_UNUSED && reg != Z80_USE_IMMED) {
+		return reg < Z80_BC ? SZ_B : SZ_W;
+	}
+	//TODO: Handle any necessary special cases
+	return SZ_B;
+}
