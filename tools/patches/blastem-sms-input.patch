-uint32_t zbreakpoint_patch(z80_context * context, uint16_t address, code_ptr dst)
-{
-	code_info code = {
-		dst,
-		dst+32,
-#ifdef X86_64
-		8
-#else
-		0
-#endif
-	};
-	mov_ir(&code, address, context->options->gen.scratch1, SZ_W);
-	call(&code, context->bp_stub);
-	return code.cur-dst;
-}
